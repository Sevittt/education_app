          // Podium Inner
          SizedBox(
            height: 320,
            child: Row(
              crossAxisAlignment: CrossAxisAlignment.end,
              mainAxisAlignment: MainAxisAlignment.center,
              children: [
                // Rank 2
                Expanded(
                  child: _buildPodiumPlace(
