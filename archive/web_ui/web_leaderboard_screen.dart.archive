              'https://lh3.googleusercontent.com/aida-public/AB6AXuBBglr5vK_orNxWzNVWKdPG5tBGF-7rnlt6BbQ_5Vk9vrnKiIPnxkk28DpZ4RYkh4YOX76Dh8XwD-JEySqUVE-JXpZ1Tv_RiqBP3jo6iiK2_TGGjNHtCduXcCBUwQ-3UU9TVD2gfzgXFNGpRXU03oF_cTBPk4ba6HjWZjjhhwGHG-92WXkYN7IVDLQPmDMHNzU7O60HXWnCvyJi5-bmMt4hoQaQlSuEd0JJb0oAIkfA7FVwg5a13krfF02BEvnqT1umRihuPna1u26I',
          statusColor: Colors.indigo,
          statusBg: Colors.indigo[50]!,
        ),
        const SizedBox(height: 12),
        _buildListRow(
          rank: 8,
          name: 'Donna Paulsen',
          level: 'Mediator',
          points: '2,040',
          avatarUrl:
              'https://lh3.googleusercontent.com/aida-public/AB6AXuAoobrZKXdLdAjx2vTYs0JDaVaEUvzXT2QAmCc0nVqT-WXvhVp-J9Jy2ySs2mqaXUhGSZkA176xHTl19M4laKbr2iMC157-0_yY_HVmjgRBz-9jMDnBCULoQ9ZqmMH0s7RS9orgF3TP38VH800aohZX3RUjvnI05QBdKwJo6v9OoaAs156FCqIENLfHI8Pez3RHPDjCtN7fgoRblU9sSPHCWGSDnRZTEweMseS-DyGQKqsNtolK8jg94Y33SylN3ERRBWMpdtgQBtrI',
          statusColor: Colors.pink,
          statusBg: Colors.pink[50]!,
        ),
      ],
    );
  }

  Widget _buildListRow({
    required int rank,
    required String name,
    required String level,
    required String points,
    required String avatarUrl,
    required Color statusColor,
    required Color statusBg,
  }) {
    final isDesktop = MediaQuery.of(context).size.width >= 768;

    return Container(
      padding: const EdgeInsets.all(16),
      decoration: BoxDecoration(
        color: Colors.white,
        borderRadius: BorderRadius.circular(16),
        boxShadow: const [
          BoxShadow(color: Colors.black12, blurRadius: 4, offset: Offset(0, 2)),
        ],
        border: Border.all(color: Colors.transparent),
      ),
      child: Row(
        children: [
          SizedBox(
            width: isDesktop ? 48 : 32,
            child: Text(
              rank.toString(),
              textAlign: TextAlign.center,
              style: GoogleFonts.spaceGrotesk(
                color: Colors.grey[400],
                fontSize: 16,
                fontWeight: FontWeight.bold,
              ),
            ),
          ),
          Expanded(
            flex: isDesktop
                ? 5
                : 1, // On mobile, user area takes up full remaining space
            child: Row(
              children: [
                Container(
                  width: 48,
                  height: 48,
                  decoration: BoxDecoration(
                    shape: BoxShape.circle,
                    image: DecorationImage(
                      image: NetworkImage(avatarUrl),
                      fit: BoxFit.cover,
                    ),
                  ),
                ),
                const SizedBox(width: 16),
                Column(
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                    Text(
                      name,
                      style: GoogleFonts.spaceGrotesk(
                        color: _neutralText,
                        fontSize: 16,
                        fontWeight: FontWeight.bold,
                      ),
                    ),
                    if (!isDesktop)
                      Text(
                        '$level • $points pts',
                        style: GoogleFonts.spaceGrotesk(
                          color: Colors.grey[500],
                          fontSize: 12,
                        ),
                      ),
                  ],
                ),
              ],
            ),
          ),
          if (isDesktop)
            Expanded(
              flex: 3,
              child: Align(
                alignment: Alignment.centerLeft,
                child: Container(
                  padding: const EdgeInsets.symmetric(
                    horizontal: 12,
                    vertical: 4,
                  ),
                  decoration: BoxDecoration(
                    color: statusBg,
                    borderRadius: BorderRadius.circular(16),
                    border:
                        Border.all(color: statusColor.withValues(alpha: 0.2)),
                  ),
                  child: Text(
                    level.toUpperCase(),
                    style: GoogleFonts.spaceGrotesk(
                      color: statusColor,
                      fontSize: 10,
                      fontWeight: FontWeight.bold,
                      letterSpacing: 1,
                    ),
                  ),
                ),
              ),
            ),
          if (isDesktop)
            Expanded(
              flex: 3,
              child: Text(
                points,
                textAlign: TextAlign.right,
                style: GoogleFonts.spaceGrotesk(
                  color: _primary,
                  fontSize: 18,
                  fontWeight: FontWeight.bold,
                ),
              ),
            ),
        ],
      ),
    );
  }

  Widget _buildLoadMoreButton() {
    return Center(
      child: InkWell(
        onTap: () {},
        borderRadius: BorderRadius.circular(32),
        child: Container(
          padding: const EdgeInsets.symmetric(horizontal: 24, vertical: 12),
          decoration: BoxDecoration(
            color: Colors.white,
            borderRadius: BorderRadius.circular(32),
            boxShadow: const [
              BoxShadow(
                color: Colors.black12,
                blurRadius: 4,
                offset: Offset(0, 2),
              ),
            ],
          ),
          child: Row(
            mainAxisSize: MainAxisSize.min,
            children: [
              Text(
                'Load More',
                style: GoogleFonts.spaceGrotesk(
                  color: Colors.grey[600],
                  fontSize: 14,
                  fontWeight: FontWeight.bold,
                ),
              ),
              const SizedBox(width: 8),
              Icon(Icons.expand_more, color: Colors.grey[600]),
            ],
          ),
        ),
      ),
    );
  }
}
