import 'package:flutter/material.dart';
import 'package:google_fonts/google_fonts.dart';

class WebJudicialSystemsScreen extends StatelessWidget {
  const WebJudicialSystemsScreen({super.key});

  final Color _primaryColor = const Color(0xFF2C0FBD);

  final Color _backgroundLight = const Color(0xFFF4F7FE);
  final Color _backgroundDark = const Color(0xFF131022);
  final Color _surfaceLight = Colors.white;
  final Color _surfaceDark = const Color(0xFF1F1B36);
  final Color _textMain = const Color(0xFF121118);
  final Color _textSecondary = const Color(0xFF686189);

  @override
  Widget build(BuildContext context) {
    final bool isDark = Theme.of(context).brightness == Brightness.dark;
    final Color bgColor = isDark ? _backgroundDark : _backgroundLight;
    final Color surfaceColor = isDark ? _surfaceDark : _surfaceLight;
    final Color textColor = isDark ? Colors.white : _textMain;
    final Color textSecondaryColor = isDark ? Colors.white70 : _textSecondary;

    return Scaffold(
      backgroundColor: bgColor,
      body: Column(
        children: [
          _buildNavbar(context, isDark, surfaceColor, textColor),
          Expanded(
            child: SingleChildScrollView(
              padding: const EdgeInsets.symmetric(horizontal: 24, vertical: 48),
              child: Center(
                child: ConstrainedBox(
                  constraints: const BoxConstraints(maxWidth: 1200),
                  child: Column(
                    crossAxisAlignment: CrossAxisAlignment.stretch,
                    children: [
                      _buildHeaderAndSearch(
                        context,
                        isDark,
                        surfaceColor,
                        textColor,
                        textSecondaryColor,
                      ),
                      const SizedBox(height: 40),
                      _buildHeroCard(
                        context,
                        isDark,
                        surfaceColor,
                        textColor,
                        textSecondaryColor,
                      ),
                      const SizedBox(height: 48),
                      _buildGridSectionHeader(context, isDark, textColor),
                      const SizedBox(height: 32),
                      _buildCourtsGrid(
                        context,
                        isDark,
                        surfaceColor,
                        textColor,
                        textSecondaryColor,
                      ),
                      const SizedBox(height: 48),
                      _buildBannerSection(context),
                    ],
                  ),
                ),
              ),
            ),
          ),
        ],
      ),
    );
  }

  Widget _buildNavbar(
    BuildContext context,
    bool isDark,
    Color surfaceColor,
    Color textColor,
  ) {
    return Container(
      padding: const EdgeInsets.symmetric(horizontal: 24, vertical: 16),
      decoration: BoxDecoration(
        color: surfaceColor.withValues(alpha: 0.9),
        border: Border(
          bottom: BorderSide(
            color: isDark
                ? Colors.white.withValues(alpha: 0.05)
                : Colors.grey.shade100,
          ),
        ),
      ),
      child: Center(
        child: ConstrainedBox(
          constraints: const BoxConstraints(maxWidth: 1200),
          child: Row(
            mainAxisAlignment: MainAxisAlignment.spaceBetween,
            children: [
              Row(
                children: [
                  Container(
                    width: 40,
                    height: 40,
                    decoration: BoxDecoration(
                      color: _primaryColor.withValues(alpha: 0.1),
                      borderRadius: BorderRadius.circular(12),
                    ),
                    child: Icon(Icons.gavel, color: _primaryColor),
                  ),
                  const SizedBox(width: 12),
                  Text.rich(
                    TextSpan(
                      text: 'Legal Edu ',
                      style: GoogleFonts.inter(
                        fontSize: 20,
                        fontWeight: FontWeight.w800,
                        color: textColor,
                        letterSpacing: -0.5,
                      ),
                      children: [
                        TextSpan(
                          text: 'Platform',
                          style: TextStyle(color: _primaryColor),
                        ),
                      ],
                    ),
                  ),
                ],
              ),
              if (MediaQuery.of(context).size.width >= 768)
                Row(
                  children: [
                    _buildNavText('Home', false, isDark, textColor),
                    const SizedBox(width: 32),
                    _buildNavText('Directory', true, isDark, textColor),
                    const SizedBox(width: 32),
                    _buildNavText('Cases', false, isDark, textColor),
                    const SizedBox(width: 32),
                    _buildNavText('Study Materials', false, isDark, textColor),
                  ],
                ),
              ElevatedButton(
                onPressed: () {},
                style: ElevatedButton.styleFrom(
                  backgroundColor: _primaryColor,
                  foregroundColor: Colors.white,
                  padding: const EdgeInsets.symmetric(
                    horizontal: 24,
                    vertical: 12,
                  ),
                  shape: RoundedRectangleBorder(
                    borderRadius: BorderRadius.circular(9999),
                  ),
                  elevation: 8,
                  shadowColor: _primaryColor.withValues(alpha: 0.5),
                ),
                child: Text(
                  'Sign In',
                  style: GoogleFonts.inter(
                    fontSize: 14,
                    fontWeight: FontWeight.bold,
                  ),
                ),
              ),
            ],
          ),
        ),
      ),
    );
  }

  Widget _buildNavText(
    String text,
    bool isActive,
    bool isDark,
    Color textColor,
  ) {
    return Text(
      text,
      style: GoogleFonts.inter(
        fontSize: 14,
        fontWeight: FontWeight.w600,
        color: isActive
            ? _primaryColor
            : (isDark ? Colors.white70 : _textMain.withValues(alpha: 0.8)),
      ),
    );
  }

  Widget _buildHeaderAndSearch(
    BuildContext context,
    bool isDark,
    Color surfaceColor,
    Color textColor,
    Color textSecondaryColor,
  ) {
    return LayoutBuilder(
      builder: (context, constraints) {
        final isMobile = constraints.maxWidth < 768;

        final titleCol = Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            Text.rich(
              TextSpan(
                text: 'Judicial Systems\n',
                style: GoogleFonts.inter(
                  fontSize: isMobile ? 36 : 48,
                  fontWeight: FontWeight.w900,
                  color: textColor,
                  height: 1.1,
                  letterSpacing: -1,
                ),
                children: [
                  TextSpan(
                    text: 'Directory',
                    style:
                        TextStyle(color: _primaryColor.withValues(alpha: 0.8)),
                  ),
                ],
              ),
            ),
            const SizedBox(height: 12),
            Text(
              'Explore the hierarchy, jurisdiction, and structure of courts nationwide.',
              style: GoogleFonts.inter(
                fontSize: 18,
                fontWeight: FontWeight.w500,
                color: textSecondaryColor,
              ),
            ),
          ],
        );

        final searchBox = Container(
          width: isMobile ? double.infinity : 400,
          margin: EdgeInsets.only(top: isMobile ? 24 : 0),
          decoration: BoxDecoration(
            color: surfaceColor,
            borderRadius: BorderRadius.circular(9999),
            boxShadow: [
              BoxShadow(
                color: Colors.black.withValues(alpha: 0.04),
                blurRadius: 30,
                offset: const Offset(0, 8),
              ),
            ],
          ),
          padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 4),
          child: Row(
            children: [
              Icon(Icons.search, color: textSecondaryColor),
              const SizedBox(width: 12),
              Expanded(
                child: TextField(
                  decoration: InputDecoration(
                    hintText: 'Search by court name, location...',
                    hintStyle: GoogleFonts.inter(
                      color: textSecondaryColor.withValues(alpha: 0.5),
                    ),
                    border: InputBorder.none,
                  ),
                  style: GoogleFonts.inter(
                    color: textColor,
                    fontWeight: FontWeight.w500,
                  ),
                ),
              ),
            ],
          ),
        );

        if (isMobile) {
          return Column(
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [titleCol, searchBox],
          );
        }

        return Row(
          crossAxisAlignment: CrossAxisAlignment.end,
          mainAxisAlignment: MainAxisAlignment.spaceBetween,
          children: [
            Expanded(child: titleCol),
            const SizedBox(width: 24),
            searchBox,
          ],
        );
      },
    );
  }

  Widget _buildHeroCard(
    BuildContext context,
    bool isDark,
    Color surfaceColor,
    Color textColor,
    Color textSecondaryColor,
  ) {
    final bool isMobile = MediaQuery.of(context).size.width < 768;

    return Container(
      padding: EdgeInsets.all(isMobile ? 32 : 40),
      decoration: BoxDecoration(
        color: surfaceColor,
        borderRadius: BorderRadius.circular(24),
        border: Border.all(
          color: isDark
              ? Colors.white.withValues(alpha: 0.05)
              : Colors.white.withValues(alpha: 0.5),
        ),
        boxShadow: [
          BoxShadow(
            color: _primaryColor.withValues(alpha: 0.08),
            blurRadius: 40,
            offset: const Offset(0, 20),
          ),
        ],
      ),
      child: Row(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          Container(
            width: 80,
            height: 80,
            decoration: BoxDecoration(
              color: isDark
                  ? Colors.amber.shade900.withValues(alpha: 0.2)
                  : Colors.amber.shade100.withValues(alpha: 0.5),
              borderRadius: BorderRadius.circular(24),
            ),
            child: Icon(
              Icons.account_balance,
              color: isDark ? Colors.amber.shade400 : Colors.amber.shade600,
              size: 40,
            ),
          ),
          const SizedBox(width: 32),
          Expanded(
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                Row(
                  mainAxisAlignment: MainAxisAlignment.spaceBetween,
                  children: [
                    Column(
                      crossAxisAlignment: CrossAxisAlignment.start,
                      children: [
                        Container(
                          padding: const EdgeInsets.symmetric(
                            horizontal: 12,
                            vertical: 4,
                          ),
                          decoration: BoxDecoration(
                            color: isDark
                                ? Colors.amber.shade900.withValues(alpha: 0.3)
                                : Colors.amber.shade50,
                            borderRadius: BorderRadius.circular(9999),
                          ),
                          child: Text(
                            'HIGHEST FEDERAL COURT',
                            style: GoogleFonts.inter(
                              fontSize: 12,
                              fontWeight: FontWeight.bold,
                              letterSpacing: 1,
                              color: isDark
                                  ? Colors.amber.shade300
                                  : Colors.amber.shade600,
                            ),
                          ),
                        ),
                        const SizedBox(height: 8),
                        Text(
                          'Supreme Court of the United States',
                          style: GoogleFonts.inter(
                            fontSize: isMobile ? 24 : 32,
                            fontWeight: FontWeight.bold,
                            color: textColor,
                          ),
                        ),
                      ],
                    ),
                    if (!isMobile)
                      TextButton.icon(
                        onPressed: () {},
                        icon: const Text('View Structure & Details'),
                        label: const Icon(Icons.arrow_forward, size: 18),
                        style: TextButton.styleFrom(
                          foregroundColor: _primaryColor,
                          backgroundColor:
                              _primaryColor.withValues(alpha: 0.05),
                          padding: const EdgeInsets.symmetric(
                            horizontal: 20,
                            vertical: 12,
                          ),
                          shape: RoundedRectangleBorder(
                            borderRadius: BorderRadius.circular(9999),
                          ),
                          textStyle: GoogleFonts.inter(
                            fontWeight: FontWeight.bold,
                          ),
                        ),
                      ),
                  ],
                ),
                const SizedBox(height: 16),
                Text(
                  'The highest court in the federal judiciary of the United States. It has ultimate appellate jurisdiction over all federal and state court cases that involve a point of federal law, and original jurisdiction over a narrow range of cases.',
                  style: GoogleFonts.inter(
                    fontSize: 16,
                    color: textSecondaryColor,
                    height: 1.6,
                  ),
                ),
                const SizedBox(height: 24),
                Wrap(
                  spacing: 12,
                  runSpacing: 12,
                  children: [
                    _buildInfoChip(
                      icon: Icons.public,
                      text: 'National Jurisdiction',
                      isDark: isDark,
                      textColor: textColor,
                    ),
                    _buildInfoChip(
                      icon: Icons.gavel,
                      text: '9 Justices',
                      isDark: isDark,
                      textColor: textColor,
                    ),
                    _buildInfoChip(
                      icon: Icons.location_on,
                      text: 'Washington, D.C.',
                      isDark: isDark,
                      textColor: textColor,
                    ),
                  ],
                ),
                if (isMobile) ...[
                  const SizedBox(height: 24),
                  SizedBox(
                    width: double.infinity,
                    child: TextButton.icon(
                      onPressed: () {},
                      icon: const Text('View Structure & Details'),
                      label: const Icon(Icons.arrow_forward, size: 18),
                      style: TextButton.styleFrom(
                        foregroundColor: _primaryColor,
                        backgroundColor: _primaryColor.withValues(alpha: 0.05),
                        padding: const EdgeInsets.symmetric(vertical: 16),
                        shape: RoundedRectangleBorder(
                          borderRadius: BorderRadius.circular(9999),
                        ),
                        textStyle: GoogleFonts.inter(
                          fontWeight: FontWeight.bold,
                        ),
                      ),
                    ),
                  ),
                ],
              ],
            ),
          ),
        ],
      ),
    );
  }

  Widget _buildInfoChip({
    required IconData icon,
    required String text,
    required bool isDark,
    required Color textColor,
  }) {
    return Container(
      padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 8),
      decoration: BoxDecoration(
        color: isDark ? _backgroundDark : _backgroundLight,
        borderRadius: BorderRadius.circular(8),
        border: Border.all(
          color: isDark
              ? Colors.white.withValues(alpha: 0.05)
              : Colors.grey.shade100,
        ),
      ),
      child: Row(
        mainAxisSize: MainAxisSize.min,
        children: [
          Icon(icon, size: 16, color: _primaryColor),
          const SizedBox(width: 8),
          Text(
            text,
            style: GoogleFonts.inter(
              fontSize: 14,
              fontWeight: FontWeight.w600,
              color: textColor,
            ),
          ),
        ],
      ),
    );
  }

  Widget _buildGridSectionHeader(
    BuildContext context,
    bool isDark,
    Color textColor,
  ) {
    return Row(
      mainAxisAlignment: MainAxisAlignment.spaceBetween,
      children: [
        Text(
          'Regional & Specialized Courts',
          style: GoogleFonts.inter(
            fontSize: 24,
            fontWeight: FontWeight.bold,
            color: textColor,
          ),
        ),
        TextButton(
          onPressed: () {},
          style: TextButton.styleFrom(
            foregroundColor: _primaryColor,
            textStyle: GoogleFonts.inter(
              fontSize: 14,
              fontWeight: FontWeight.bold,
            ),
          ),
          child: const Row(
            children: [
              Text('View All'),
              SizedBox(width: 4),
              Icon(Icons.arrow_forward, size: 16),
            ],
          ),
        ),
      ],
    );
  }

  Widget _buildCourtsGrid(
    BuildContext context,
    bool isDark,
    Color surfaceColor,
    Color textColor,
    Color textSecondaryColor,
  ) {
    return LayoutBuilder(
      builder: (context, constraints) {
        int crossAxisCount = 1;
        if (constraints.maxWidth >= 768) crossAxisCount = 2;
        if (constraints.maxWidth >= 1024) crossAxisCount = 3;

        return GridView.count(
          crossAxisCount: crossAxisCount,
          shrinkWrap: true,
          physics: const NeverScrollableScrollPhysics(),
          childAspectRatio: 0.85,
          crossAxisSpacing: 24,
          mainAxisSpacing: 24,
          children: [
            _buildCourtCard(
              title: 'U.S. Courts of Appeals',
              description:
                  'The intermediate appellate courts of the United States federal judiciary.',
              type: 'Federal',
              icon: Icons.balance,
              themeColor: Colors.blue,
              tags: ['Civil Cases', 'Criminal Cases'],
              tagColors: [Colors.green, Colors.red],
              statsText: '13 Circuits',
              isDark: isDark,
              surfaceColor: surfaceColor,
              textColor: textColor,
              textSecondaryColor: textSecondaryColor,
            ),
            _buildCourtCard(
              title: 'U.S. District Courts',
              description:
                  'The general trial courts of the United States federal judiciary.',
              type: 'Federal',
              icon: Icons.gavel,
              themeColor: Colors.purple,
              tags: ['Civil Cases', 'Criminal Cases'],
              tagColors: [Colors.green, Colors.red],
              statsText: '94 Districts',
              isDark: isDark,
              surfaceColor: surfaceColor,
              textColor: textColor,
              textSecondaryColor: textSecondaryColor,
            ),
            _buildCourtCard(
              title: 'U.S. Bankruptcy Courts',
              description:
                  'Specialized courts that handle all bankruptcy cases.',
              type: 'Specialized',
              icon: Icons.shield,
              themeColor: Colors.orange,
              tags: ['Insolvency', 'Civil'],
              tagColors: [Colors.indigo, Colors.green],
              statsText: 'Financial',
              isDark: isDark,
              surfaceColor: surfaceColor,
              textColor: textColor,
              textSecondaryColor: textSecondaryColor,
            ),
            _buildCourtCard(
              title: 'Court of International Trade',
              description:
                  'Jurisdiction over civil actions arising out of U.S. customs and international trade laws.',
              type: 'Specialized',
              icon: Icons.handshake,
              themeColor: Colors.teal,
              tags: ['Trade Disputes'],
              tagColors: [Colors.green],
              statsText: 'Global',
              isDark: isDark,
              surfaceColor: surfaceColor,
              textColor: textColor,
              textSecondaryColor: textSecondaryColor,
            ),
            _buildCourtCard(
              title: 'Family Courts',
              description:
                  'Courts of limited jurisdiction that hear cases involving family law.',
              type: 'State',
              icon: Icons.family_restroom,
              themeColor: Colors.pink,
              tags: ['Civil Cases', 'Domestic'],
              tagColors: [Colors.green, Colors.pink],
              statsText: 'Local Level',
              isDark: isDark,
              surfaceColor: surfaceColor,
              textColor: textColor,
              textSecondaryColor: textSecondaryColor,
            ),
            _buildCourtCard(
              title: 'Criminal Courts',
              description:
                  'Courts that have jurisdiction to try and punish offenders against criminal law.',
              type: 'State',
              icon: Icons.local_police,
              themeColor: Colors.cyan,
              tags: ['Criminal Cases', 'Felonies'],
              tagColors: [Colors.red, Colors.blue],
              statsText: 'State Level',
              isDark: isDark,
              surfaceColor: surfaceColor,
              textColor: textColor,
              textSecondaryColor: textSecondaryColor,
            ),
          ],
        );
      },
    );
  }

  Widget _buildCourtCard({
    required String title,
    required String description,
    required String type,
    required IconData icon,
    required MaterialColor themeColor,
    required List<String> tags,
    required List<MaterialColor> tagColors,
    required String statsText,
    required bool isDark,
    required Color surfaceColor,
    required Color textColor,
    required Color textSecondaryColor,
  }) {
    return Container(
      padding: const EdgeInsets.all(24),
      decoration: BoxDecoration(
        color: surfaceColor,
        borderRadius: BorderRadius.circular(16),
        border: Border.all(color: Colors.transparent),
        boxShadow: [
          BoxShadow(
            color: Colors.black.withValues(alpha: 0.04),
            blurRadius: 30,
            offset: const Offset(0, 8),
          ),
        ],
      ),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          Row(
            mainAxisAlignment: MainAxisAlignment.spaceBetween,
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              Container(
                width: 48,
                height: 48,
                decoration: BoxDecoration(
                  color: isDark
                      ? themeColor.shade900.withValues(alpha: 0.2)
                      : themeColor.shade100.withValues(alpha: 0.5),
                  borderRadius: BorderRadius.circular(12),
                ),
                child: Icon(
                  icon,
                  color: isDark ? themeColor.shade400 : themeColor.shade600,
                  size: 24,
                ),
              ),
              Container(
                padding: const EdgeInsets.symmetric(horizontal: 8, vertical: 4),
                decoration: BoxDecoration(
                  color: isDark
                      ? Colors.white.withValues(alpha: 0.1)
                      : Colors.grey.shade100,
                  borderRadius: BorderRadius.circular(4),
                ),
                child: Text(
                  type,
                  style: GoogleFonts.inter(
                    fontSize: 12,
                    fontWeight: FontWeight.bold,
                    color: isDark ? Colors.grey.shade300 : textSecondaryColor,
                  ),
                ),
              ),
            ],
          ),
          const SizedBox(height: 16),
          Text(
            title,
            style: GoogleFonts.inter(
              fontSize: 18,
              fontWeight: FontWeight.bold,
              color: textColor,
            ),
          ),
          const SizedBox(height: 4),
          Text(
            description,
            style: GoogleFonts.inter(fontSize: 14, color: textSecondaryColor),
            maxLines: 2,
            overflow: TextOverflow.ellipsis,
          ),
          const SizedBox(height: 24),
          Wrap(
            spacing: 8,
            runSpacing: 8,
            children: List.generate(tags.length, (index) {
              return Container(
                padding: const EdgeInsets.symmetric(
                  horizontal: 10,
                  vertical: 4,
                ),
                decoration: BoxDecoration(
                  color: isDark
                      ? tagColors[index].shade900.withValues(alpha: 0.2)
                      : tagColors[index].shade100.withValues(alpha: 0.5),
                  borderRadius: BorderRadius.circular(6),
                ),
                child: Text(
                  tags[index],
                  style: GoogleFonts.inter(
                    fontSize: 12,
                    fontWeight: FontWeight.bold,
                    color: isDark
                        ? tagColors[index].shade300
                        : tagColors[index].shade700,
                  ),
                ),
              );
            }),
          ),
          const Spacer(),
          Container(
            padding: const EdgeInsets.only(top: 16),
            decoration: BoxDecoration(
              border: Border(
                top: BorderSide(
                  color: isDark
                      ? Colors.white.withValues(alpha: 0.05)
                      : Colors.grey.shade50,
                ),
              ),
            ),
            child: Row(
              mainAxisAlignment: MainAxisAlignment.spaceBetween,
              children: [
                Text(
                  statsText,
                  style: GoogleFonts.inter(
                    fontSize: 12,
                    fontWeight: FontWeight.w500,
                    color: textSecondaryColor,
                  ),
                ),
                TextButton(
                  onPressed: () {},
                  style: TextButton.styleFrom(
                    padding: EdgeInsets.zero,
                    minimumSize: const Size(0, 0),
                    tapTargetSize: MaterialTapTargetSize.shrinkWrap,
                    foregroundColor: _primaryColor,
                  ),
                  child: Row(
                    children: [
                      Text(
                        'Details',
                        style: GoogleFonts.inter(
                          fontSize: 14,
                          fontWeight: FontWeight.bold,
                        ),
                      ),
                      const SizedBox(width: 4),
                      const Icon(Icons.arrow_forward, size: 16),
                    ],
                  ),
                ),
              ],
            ),
          ),
        ],
      ),
    );
  }

  Widget _buildBannerSection(BuildContext context) {
    return Container(
      width: double.infinity,
      padding: const EdgeInsets.all(48),
      decoration: BoxDecoration(
        color: _primaryColor,
        borderRadius: BorderRadius.circular(24),
        boxShadow: [
          BoxShadow(
            color: Colors.black.withValues(alpha: 0.1),
            blurRadius: 20,
            offset: const Offset(0, 10),
          ),
        ],
      ),
      child: Column(
        children: [
          Text(
            'Need help understanding jurisdiction?',
            style: GoogleFonts.inter(
              fontSize: 32,
              fontWeight: FontWeight.bold,
              color: Colors.white,
            ),
            textAlign: TextAlign.center,
          ),
          const SizedBox(height: 16),
          Text(
            'Our interactive guide helps you determine which court has authority over specific legal matters.',
            style: GoogleFonts.inter(
              fontSize: 18,
              color: Colors.white.withValues(alpha: 0.9),
            ),
            textAlign: TextAlign.center,
          ),
          const SizedBox(height: 32),
          ElevatedButton(
            onPressed: () {},
            style: ElevatedButton.styleFrom(
              backgroundColor: Colors.white,
              foregroundColor: _primaryColor,
              padding: const EdgeInsets.symmetric(horizontal: 32, vertical: 16),
              shape: RoundedRectangleBorder(
                borderRadius: BorderRadius.circular(9999),
              ),
            ),
            child: Text(
              'Start Interactive Guide',
              style: GoogleFonts.inter(
                fontSize: 14,
                fontWeight: FontWeight.bold,
              ),
            ),
          ),
        ],
      ),
    );
  }
}
