              _buildTocItem('Chapter 2: Marriage', isActive: false),
              _buildTocItem('Chapter 3: Marital Agreements', isActive: false),
              _buildTocItem('Chapter 4: Parental Rights', isActive: true),
              _buildTocItem('Chapter 5: Child Custody', isActive: false),
              _buildTocItem('Chapter 6: Support', isActive: false),
            ],
          ),
        ),
        const SizedBox(height: 24),
        // My Notes Card
        Container(
          padding: const EdgeInsets.all(24),
