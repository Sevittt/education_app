rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helper Functions ---
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ict_specialist');
    }

    function isExpertOrAdmin() {
      return isAuthenticated() && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ict_specialist' || 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ekspert' ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'judge');
    }

    // --- Users Collection ---
    // Anyone authenticated can read user profiles (needed for Leaderboard).
    // Users can only write their own profile.
    // Admins can read/write all.
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) || isAdmin();
    }

    // --- Learning Records (xAPI) ---
    // Immutable logs. Create only. No delete/update (except Admin).
    match /learning_records/{recordId} {
      allow create: if isAuthenticated() && 
                    request.resource.data.actor.mbox == ('mailto:' + request.auth.uid + '@sudqollanma.uz');
      allow read: if isAuthenticated();
      allow update: if false; // Logs are immutable
      allow delete: if isAdmin();
    }

    // --- Content Collections ---
    // PUBLIC READ for all content, Admin/Expert write
    // This allows anyone (including unauthenticated users) to read content
    match /resources/{docId} {
      allow read: if true;
      allow write: if isExpertOrAdmin();
    }

    match /knowledge_base/{docId} {
      allow read: if true;
      allow write: if isExpertOrAdmin();
    }
    
    match /video_tutorials/{docId} {
      allow read: if true;
      allow write: if isExpertOrAdmin();
    }
    
    match /systems/{docId} {
      allow read: if true;
      allow write: if isExpertOrAdmin();
    }

    match /faq/{docId} {
      allow read: if true;
      allow write: if isExpertOrAdmin();
    }

    match /faqs/{docId} {
      allow read: if true;
      allow write: if isExpertOrAdmin();
    }
    
    match /app_notifications/{docId} {
       allow read: if isAuthenticated();
       allow write: if isAdmin(); // Notifications typically Admin only
    }
    
    // --- Community Collection (discussion_topics) ---
    match /discussion_topics/{topicId} {
      allow read: if true;
      allow create: if isAuthenticated();
      // Only owner or admin can fully update or delete
      allow delete: if isOwner(resource.data.authorId) || isAdmin(); 
      // Anyone can increment commentCount
      allow update: if isOwner(resource.data.authorId) || isAdmin() || (
        isAuthenticated() && 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount'])
      );
      
      // Comments Subcollection
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuthenticated();
        allow update, delete: if isOwner(resource.data.authorId) || isAdmin();
      }
    }
    
    // Legacy fix if any code still refers to 'topics' (optional but safe)
    match /topics/{topicId} {
      allow read: if true;
    }

    // --- Quizzes Collection ---
    match /quizzes/{quizId} {
      allow read: if true;
      allow write: if isExpertOrAdmin();
      
      // Questions Subcollection
      match /questions/{questionId} {
        allow read: if true;
        allow write: if isExpertOrAdmin();
      }
    }
    
    // --- Quiz Attempts ---
    match /quiz_attempts/{attemptId} {
      allow create: if isAuthenticated();
      allow read: if isOwner(resource.data.userId) || isAdmin();
    }
    
    // --- News Collection ---
    match /news/{docId} {
      allow read: if true;
      allow write: if isExpertOrAdmin();
    }

    // --- Courses Collection ---
    match /courses/{courseId} {
      allow read: if true;
      allow write: if isExpertOrAdmin();

      // Modules subcollection
      match /modules/{moduleId} {
        allow read: if true;
        allow write: if isExpertOrAdmin();

        // Lessons nested under modules
        match /lessons/{lessonId} {
          allow read: if true;
          allow write: if isExpertOrAdmin();
        }
      }

      // Top-level lessons subcollection (legacy / flat structure)
      match /lessons/{lessonId} {
        allow read: if true;
        allow write: if isExpertOrAdmin();
      }
    }

    // --- User Course Progress ---
    // Users can only read and write their own progress.
    // Admin can read all for reporting purposes.
    match /user_course_progress/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId);

      // Per-course progress subcollection
      match /courses/{courseId} {
        allow read: if isOwner(userId) || isAdmin();
        // Only increment-based field updates allowed (prevents overwriting others' data)
        allow write: if isOwner(userId);
      }
    }

    // --- Certificates ---
    // A user can read their own certificate.
    // Only admin/system can create certificates.
    match /certificates/{certId} {
      allow read: if isAuthenticated() &&
                  resource.data.userId == request.auth.uid || isAdmin();
      allow create: if isAdmin();
      allow update: if false; // Certificates are immutable
      allow delete: if isAdmin();
    }

    // --- Default Deny (for any unmatched paths) ---
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
